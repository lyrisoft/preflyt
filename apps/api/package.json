{
  "name": "@preflyt/api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "build": "pnpm prisma:generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "start:worker:dev": "tsx watch src/worker.ts",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "start:native-controller": "node dist/execution-controller.js",
    "start:health-scanner:dev": "tsx src/health-scanner.ts",
    "start:health-scanner": "node dist/health-scanner.js"
  },
  "dependencies": {
    "@kubernetes/client-node": "2.0.0",
