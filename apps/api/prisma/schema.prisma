generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
  SUPER_ADMIN
}

enum GitHubSetupPhase {
  INSTALLATION
  USER_AUTHORIZATION
}

model Identity {
  id          String   @id @default(cuid())
  issuer      String
  subject     String
  displayName String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  membership  Membership?
  superAdminCredential SuperAdminCredential?
  sessions    WebSession[]
  bootstrapChallenges BootstrapChallenge[]
  githubSetupTransactions GitHubSetupTransaction[]
  githubInstallations GitHubInstallation[]
  @@unique([issuer, subject])
}

model Membership {
  id         String     @id @default(cuid())
  identityId String     @unique
  identity   Identity   @relation(fields: [identityId], references: [id], onDelete: Cascade)
  role       MemberRole
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model SuperAdminCredential {
  id           String   @id
  username     String   @unique
  passwordHash String
  identityId   String   @unique
  identity     Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt
}

model LoginTransaction {
  id              String   @id @default(cuid())
  stateHash       String   @unique
  browserBinding  String
  codeVerifier    String
  nonce           String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  @@index([expiresAt])
}

model WebSession {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  identityId   String
  identity     Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  @@index([identityId, expiresAt])
}

model BootstrapState {
  id         Int       @id @default(1)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model AuditEvent {
  id         String   @id @default(cuid())
  event      String
  actorId    String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  @@index([event, createdAt])
}

model BootstrapChallenge {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  @@index([expiresAt])
}

model AuthThrottle {
  id          String   @id @default(cuid())
  action      String
  keyHash     String
  windowStart DateTime
  count       Int      @default(0)
  @@unique([action, keyHash, windowStart])
}

model GitHubSetupTransaction {
  id                  String          @id @default(cuid())
  stateHash           String          @unique
  browserBindingHash  String
  identityId          String
  identity            Identity        @relation(fields: [identityId], references: [id], onDelete: Cascade)
  phase               GitHubSetupPhase @default(INSTALLATION)
  installationId      BigInt?
  codeVerifier        String?
  expiresAt           DateTime
  createdAt           DateTime        @default(now())
  @@index([expiresAt])
}

model GitHubInstallation {
  id                  BigInt             @id
  accountLogin        String
  accountType         String
  repositorySelection String
  permissions         Json
  connectedById       String
  connectedBy         Identity           @relation(fields: [connectedById], references: [id], onDelete: Restrict)
  active              Boolean            @default(true)
  lastVerifiedAt      DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  repositories        GitHubRepository[]
}

model GitHubRepository {
  id             String            @id @default(cuid())
  githubId       BigInt            @unique
  installationId BigInt
  installation   GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  name           String
  fullName       String
  ownerLogin     String
  defaultBranch  String?
  isPrivate      Boolean
  selected       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  profiles       RepositoryProfile[]
  @@index([installationId, selected])
}

model RepositoryProfile {
  id           String @id @default(cuid())
  repositoryId String
  repository   GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sourceSha    String
  treeSha      String
  branch       String
  fullName     String
  version      Int
  complete     Boolean
  report       Json
  createdAt    DateTime @default(now())
  @@index([repositoryId, createdAt])
}

// Durable inbox; Redis loss cannot discard accepted deliveries. No raw payloads or tokens.
enum GitHubDeliveryState {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model GitHubWebhookDelivery {
  id                 String @id
  ciEvidence         ImportedCiEvidence?
  traceParent        String?
  payloadHash        String
  event              String
  action             String
  installationId     BigInt
  repositoryGithubId BigInt
  sourceSha          String
  sourceObjectId     String
  sourceNumber       Int?
  sourceStatus       String?
  sourceConclusion   String?
  sourceUpdatedAt    DateTime?
  state              GitHubDeliveryState @default(RECEIVED)
  reason             String?
  receivedAt         DateTime @default(now())
  processedAt        DateTime?
  @@index([state, receivedAt])
  @@index([repositoryGithubId, receivedAt])
}

// Immutable observations of externally executed CI; not Preflyt policy verdicts.
enum ImportedCiResult {
  SUCCEEDED
  FAILED
  PENDING
  NOT_EXECUTED
  UNKNOWN
}

model ImportedCiEvidence {
  deliveryId         String @id
  artifacts          CiArtifactImport[]
  delivery           GitHubWebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  version            Int @default(1)
  repositoryGithubId BigInt
  installationId     BigInt
  sourceSha          String
  sourceKind         String
  sourceObjectId     String
  sourceAction       String
  sourceStatus       String?
  sourceConclusion   String?
  sourceUpdatedAt    DateTime?
  result             ImportedCiResult
  sourcePayloadHash  String
  evidenceHash       String
  observedAt         DateTime
  importedAt         DateTime @default(now())
  @@index([repositoryGithubId, installationId, observedAt])
  @@index([repositoryGithubId, sourceSha, observedAt])
}

// Administrator-associated original bytes; never treated as verified provider artifacts.
model CiArtifactImport {
  id            String @id @default(cuid())
  deliveryId    String
  evidence      ImportedCiEvidence @relation(fields: [deliveryId], references: [deliveryId], onDelete: Cascade, map: "CiArtifactImport_evidence_fkey")
  format        String
  sha256        String
  parserVersion Int @default(1)
  verification  String @default("ADMIN_ASSOCIATED_UNVERIFIED")
  content       Bytes
  summary       Json
  uploadedById  String
  createdAt     DateTime @default(now())
  @@unique([deliveryId, format, sha256])
}
