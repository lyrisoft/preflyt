generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
  SUPER_ADMIN
}

enum GitHubSetupPhase {
  INSTALLATION
  USER_AUTHORIZATION
}

model Identity {
  id          String   @id @default(cuid())
  issuer      String
  subject     String
  displayName String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  organizationMemberships OrganizationMembership[]
  membership  Membership?
  superAdminCredential SuperAdminCredential?
  sessions    WebSession[]
  bootstrapChallenges BootstrapChallenge[]
  githubSetupTransactions GitHubSetupTransaction[]
  githubInstallations GitHubInstallation[]
  @@unique([issuer, subject])
}

model Membership {
  id         String     @id @default(cuid())
  identityId String     @unique
  identity   Identity   @relation(fields: [identityId], references: [id], onDelete: Cascade)
  role       MemberRole
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model SuperAdminCredential {
  id           String   @id
  username     String   @unique
  passwordHash String
  identityId   String   @unique
  identity     Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt
}

model LoginTransaction {
  id              String   @id @default(cuid())
  stateHash       String   @unique
  browserBinding  String
  codeVerifier    String
  nonce           String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  @@index([expiresAt])
}

model WebSession {
  activeOrganizationId String?
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  identityId   String
  identity     Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  @@index([identityId, expiresAt])
}

model BootstrapState {
  id         Int       @id @default(1)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model AuditEvent {
  id         String   @id @default(cuid())
  event      String
  actorId    String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  @@index([event, createdAt])
}

model BootstrapChallenge {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  @@index([expiresAt])
}

model AuthThrottle {
  id          String   @id @default(cuid())
  action      String
  keyHash     String
  windowStart DateTime
  count       Int      @default(0)
  @@unique([action, keyHash, windowStart])
}

model GitHubSetupTransaction {
  organizationId String @default("preflyt-default")
  id                  String          @id @default(cuid())
  stateHash           String          @unique
  browserBindingHash  String
  identityId          String
  identity            Identity        @relation(fields: [identityId], references: [id], onDelete: Cascade)
  phase               GitHubSetupPhase @default(INSTALLATION)
  installationId      BigInt?
  codeVerifier        String?
  expiresAt           DateTime
  createdAt           DateTime        @default(now())
  @@index([expiresAt])
}

model GitHubInstallation {
  organizationId String @default("preflyt-default")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                  BigInt             @id
  accountLogin        String
  accountType         String
  repositorySelection String
  permissions         Json
  connectedById       String
  connectedBy         Identity           @relation(fields: [connectedById], references: [id], onDelete: Restrict)
  active              Boolean            @default(true)
  accessRevision      Int @default(0)
  syncState           String @default("UNKNOWN")
  lastSyncAttemptAt   DateTime?
  syncLeaseUntil      DateTime?
  lastVerifiedAt      DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  repositories        GitHubRepository[]
}

model GitHubRepository {
  id             String            @id @default(cuid())
  githubId       BigInt            @unique
  installationId BigInt
  installation   GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  name           String
  fullName       String
  ownerLogin     String
  defaultBranch  String?
  isPrivate      Boolean
  available      Boolean @default(true)
  selected       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  repositoryGrants RepositoryGrant[]
  contributorObservations ContributorObservation[]
  pullRequests RepositoryPullRequest[]
  ciBindings RepositoryCiBindings[]
  assessments    CommitAssessment[]
  standards      RepositoryStandardsSelection[]
  profiles       RepositoryProfile[]
  @@index([installationId, selected])
}

model RepositoryProfile {
  id           String @id @default(cuid())
  repositoryId String
  repository   GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sourceSha    String
  treeSha      String
  branch       String
  fullName     String
  version      Int
  complete     Boolean
  report       Json
  createdAt    DateTime @default(now())
  @@index([repositoryId, createdAt])
}

// Durable inbox; Redis loss cannot discard accepted deliveries. No raw payloads or tokens.
enum GitHubDeliveryState {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model GitHubWebhookDelivery {
  pullRequestContext Json?
  id                 String @id
  ciEvidence         ImportedCiEvidence?
  traceParent        String?
  payloadHash        String
  event              String
  action             String
  installationId     BigInt
  repositoryGithubId BigInt
  sourceSha          String
  sourceIdentity Json?
  sourceObjectId     String
  sourceNumber       Int?
  sourceStatus       String?
  sourceConclusion   String?
  sourceUpdatedAt    DateTime?
  state              GitHubDeliveryState @default(RECEIVED)
  reason             String?
  receivedAt         DateTime @default(now())
  processedAt        DateTime?
  @@index([state, receivedAt])
  @@index([repositoryGithubId, receivedAt])
}

// Immutable observations of externally executed CI; not Preflyt policy verdicts.
enum ImportedCiResult {
  SUCCEEDED
  FAILED
  PENDING
  NOT_EXECUTED
  UNKNOWN
}

model ImportedCiEvidence {
  deliveryId         String @id
  artifacts          CiArtifactImport[]
  delivery           GitHubWebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  version            Int @default(1)
  repositoryGithubId BigInt
  installationId     BigInt
  sourceSha          String
  sourceKind         String
  sourceIdentity Json?
  sourceObjectId     String
  sourceAction       String
  sourceStatus       String?
  sourceConclusion   String?
  sourceUpdatedAt    DateTime?
  result             ImportedCiResult
  sourcePayloadHash  String
  evidenceHash       String
  observedAt         DateTime
  importedAt         DateTime @default(now())
  @@index([repositoryGithubId, installationId, observedAt])
  @@index([repositoryGithubId, sourceSha, observedAt])
}

// Administrator-associated original bytes. Separate immutable attestations can verify provenance.
model CiArtifactImport {
  id            String @id @default(cuid())
  deliveryId    String
  evidence      ImportedCiEvidence @relation(fields: [deliveryId], references: [deliveryId], onDelete: Cascade, map: "CiArtifactImport_evidence_fkey")
  format        String
  sha256        String
  parserVersion Int @default(1)
  verification  String @default("ADMIN_ASSOCIATED_UNVERIFIED")
  content       Bytes
  summary       Json
  uploadedById  String
  attestations CiArtifactAttestation[]
  createdAt     DateTime @default(now())
  @@unique([deliveryId, format, sha256])
}

// Append-only adopted pack versions; catalogue/profile changes never auto-upgrade selection.
model RepositoryStandardsSelection {
  id                String @id @default(cuid())
  repositoryId      String
  repository        GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  revision          Int
  profile           String
  packs             Json
  selectedById      String
  profileSnapshotId String?
  sourceSha         String?
  createdAt         DateTime @default(now())
  @@unique([repositoryId, revision])
}

// Immutable exact-SHA reports; administrative associations never establish trusted gates.
model CommitAssessment {
  id             String @id @default(cuid())
  repositoryId   String
  repository     GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sourceSha      String
  selectionId    String
  requestKey     String
  inputHash      String
  request        Json
  plan           Json
  report         Json
  assessmentHash String
  createdAt      DateTime @default(now())
  @@unique([repositoryId, requestKey])
  @@index([repositoryId, sourceSha, createdAt])
  @@index([repositoryId, createdAt])
}

model GitHubAccessDelivery {
  id String @id
  payloadHash String
  installationId BigInt
  event String
  action String
  state GitHubDeliveryState @default(RECEIVED)
  receivedAt DateTime @default(now())
  processedAt DateTime?
  @@index([state, receivedAt])
}

model RepositoryCiBindings {
  id String @id @default(cuid())
  repositoryId String
  repository GitHubRepository @relation(fields:[repositoryId],references:[id],onDelete:Cascade)
  revision Int
  selectionId String
  bindings Json
  createdAt DateTime @default(now())
  @@unique([repositoryId,revision])
}

model RepositoryPullRequest {
 verifiedInstallationId String?
 verifiedAccessRevision Int?
 id String @id @default(cuid())
 repositoryId String
 repository GitHubRepository @relation(fields:[repositoryId],references:[id],onDelete:Cascade)
 number Int
 objectId String
 context Json
 sourceUpdatedAt DateTime?
 revision Int @default(1)
 syncState String @default("PENDING")
 verifiedAt DateTime?
 lastSyncAttemptAt DateTime?
 @@unique([repositoryId,number])
 @@index([lastSyncAttemptAt])
}

// Append-only cryptographic verification receipts. Original uploads/labels stay unchanged.
model CiArtifactAttestation {
  id String @id @default(cuid())
  artifactId String
  artifact CiArtifactImport @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  bundle Bytes
  bundleSha256 String
  policyDigest String
  receiptHash String
  claims Json
  verifiedById String
  createdAt DateTime @default(now())
  @@unique([artifactId, policyDigest])
}


enum OrganizationRole {
  OWNER
  ADMIN
  POLICY_MANAGER
  SECURITY_ENGINEER
  ENGINEERING_LEAD
  DEVELOPER
  AUDITOR
  VIEWER
}

model Organization {
  id            String                   @id @default(cuid())
  name          String
  createdAt     DateTime                 @default(now())
  memberships   OrganizationMembership[]
  installations GitHubInstallation[]
}

model OrganizationMembership {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identityId     String
  identity       Identity          @relation(fields: [identityId], references: [id], onDelete: Cascade)
  role           OrganizationRole
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  grants         RepositoryGrant[]

  @@unique([organizationId, identityId])
}

model RepositoryGrant {
  id           String                 @id @default(cuid())
  membershipId String
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  repositoryId String
  repository   GitHubRepository       @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime               @default(now())

  @@unique([membershipId, repositoryId])
}

// Stable provider identity is installation-scoped; Git author names are never identity keys.
model Contributor {
  id             String                   @id @default(cuid())
  installationId BigInt
  githubUserId   String
  login          String
  kind           String
  lastObservedAt DateTime
  observations   ContributorObservation[]

  @@unique([installationId, githubUserId])
}

// Immutable signed observations. Raw payload, email, review body and commit messages are omitted.
model ContributorDelivery {
  id           String   @id
  payloadHash  String
  repositoryId String
  observedAt   DateTime
  receivedAt   DateTime @default(now())
}

model ContributorObservation {
  id                String           @id @default(cuid())
  deliveryId        String
  repositoryId      String
  repository        GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  contributorId     String
  contributor       Contributor      @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  relationship      String
  sourceObjectId    String
  sourceSha         String
  pullRequestNumber Int?
  action            String
  state             String?
  merged            Boolean          @default(false)
  observedAt        DateTime

  @@unique([deliveryId, contributorId, relationship, sourceObjectId])
  @@index([repositoryId, observedAt])
  @@index([contributorId, observedAt])
}
