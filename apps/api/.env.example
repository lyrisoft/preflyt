# Application connections and feature switches: Settings → Configuration.
# Legacy environment values are imported once on first API startup.
# Keep this key stable and back it up separately from the database.
CONFIGURATION_ENCRYPTION_KEY=
DATABASE_URL=postgresql://preflyt:replace-me@localhost:5432/preflyt
WEB_ORIGIN=http://localhost:5173
BOOTSTRAP_TOKEN_SHA256=sha256-hex-of-out-of-band-token
COOKIE_SECURE=false

# Optional; configure both values to seed one local break-glass Super Admin.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# Optional metadata cache; unset to bypass. Each deployment needs a unique prefix.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_PREFIX=preflyt:development:cache

# P1.1 webhook ingestion and its separate durable queue worker (disabled by default).
# Local development may use redis://127.0.0.1:6379/1 with noeviction.
# Production queues require dedicated persistent Redis, separate from cache eviction.
QUEUE_REDIS_URL=
QUEUE_PREFIX=preflyt:development:queue

# Optional offline GitHub Actions report attestations. All values required; no credentials.
# Pin a reviewed gh binary and Sigstore trusted root; SHA-256 values must match files.
CI_ATTESTATION_GH_PATH=
CI_ATTESTATION_GH_SHA256=
CI_ATTESTATION_ROOT_PATH=
CI_ATTESTATION_ROOT_SHA256=
# JSON array, for example ["owner/repo/.github/workflows/ci.yml"]
CI_ATTESTATION_WORKFLOWS=

# GitHub human login (optional). Register this callback separately from installation setup.
# Required when GitHub login is enabled: base64 of 32 random bytes.
# Generate with: openssl rand -base64 32
# Keep this key in deployment secrets and backups; changing it invalidates stored tokens.
GITHUB_USER_TOKEN_ENCRYPTION_KEY=


# Manual policy-aware checks: repository Checks: write and Actions: read.
# Production prerequisites and limits: docs/deployment/github-governance-production.md

# Separate privileged governance connection. Organization Administration: write is required.
# Development only: shared assessment App, restricted to lyrisoft/preflyt-p2-acceptance.
GITHUB_GOVERNANCE_LOCAL_ACCEPTANCE=false
# JSON execution contracts pin reviewed workflow SHA, report format and tool version.
CI_EXECUTION_CONTRACTS=

# Report proof: github-native (default) or organization-key for private repositories.
CI_REPORT_PROOF_MODE=github-native
# Public key allowlist JSON only; never include private signing keys.
CI_ORGANIZATION_SIGNER_KEYS=

# Optional retained GitHub ruleset evaluations (repository Administration: read).

# P3 read-only sandbox preflight. Does not enable repository execution.
# Enable only with a current independent runtime review and a deployed job controller.
NATIVE_RUNTIME_APPROVAL=
NATIVE_RUNTIME_REVIEW_KEYS=[]
NATIVE_CONTROLLER_API_KEY=

# Native check planning only. Reviewed image digests/config/license; never repository-supplied commands.
NATIVE_TOOL_REVIEWS=[]

# Organization AI configuration; no inference or repository source transmission in this release.
# Advisory instruction-only reviews; requires tested routes and model rates.
# A separate persistent 32-byte base64 key. Never reuse the GitHub user-token key.
AI_PROVIDER_ENCRYPTION_KEY=
# Models and endpoints are created by organization admins in AI Intelligence.

# Optional installation reporting is enabled by default (opt-out).
# A receiver URL is required before any report can be delivered.
# Set false before the first startup to prevent all installation reports.
PREFLYT_INSTALLATION_REPORTING_ENABLED=true
PREFLYT_INSTALLATION_REPORTING_URL=
# compose, kubernetes, linux, development, or unknown; no host/repository details.
PREFLYT_DEPLOYMENT_TYPE=unknown

# Country reporting is off until an administrator enables it. Set false to enforce off.
PREFLYT_INSTALLATION_COUNTRY_REPORTING_ENABLED=

# Optional public API base for hosted MCP and companion OAuth; defaults to WEB_ORIGIN/api.
PREFLYT_PUBLIC_API_URL=
