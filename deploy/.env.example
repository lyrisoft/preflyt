# Application connections and feature switches: Settings → Configuration.
# Legacy environment values are imported once on first API startup.
# Keep this key stable and back it up separately from the database.
CONFIGURATION_ENCRYPTION_KEY=
# Generate before first startup: a separate persistent 32-byte base64 key.
# API and worker must use the same value. Never reuse another encryption key.
AI_PROVIDER_ENCRYPTION_KEY=
# Legacy location. Prefer the identical canonical root .env.example.
# Generate fresh hexadecimal database passwords. Do not reuse apps/api/.env.
POSTGRES_PASSWORD=
DATABASE_APP_PASSWORD=
PREFLYT_VERSION=development
PREFLYT_HTTP_PORT=8080
# Production: external HTTPS origin behind your host's TLS reverse proxy.
# Local-only: use http://localhost:8080 with compose.local.yaml.
WEB_ORIGIN=https://preflyt.example.com
# Configure both values to seed the recovery account (password: 24-128 chars).
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
# Identity provider connections are configured in Settings → Configuration.
BOOTSTRAP_TOKEN_SHA256=

# Bundled cache service; override only for a separately managed service.
REDIS_URL=redis://cache:6379/0
REDIS_CACHE_PREFIX=preflyt:production:cache
# Shared by API and worker. Display access proof lasts 5–60 seconds; writes stay fresh.
GITHUB_ACCESS_CACHE_SECONDS=30
# Keep this percentage of each observed GitHub budget available to interactive work.
GITHUB_INTERACTIVE_RESERVE_PERCENT=10
# Maximum saved-display refresh jobs per worker pass (1–50).
GITHUB_DISPLAY_REFRESH_BATCH=10
GITHUB_DISPLAY_STALL_SECONDS=180

# Webhook ingestion is opt-in; the worker starts with the stack and waits for events.
# Compose has separate cache and persistent queue services; no host Redis is needed.
QUEUE_REDIS_URL=redis://queue:6379/0
QUEUE_PREFIX=preflyt:production:queue

# Local source builds use preflyt-local. Published releases use ghcr.io/lyrisoft.
PREFLYT_IMAGE_REGISTRY=preflyt-local
# Telemetry is disabled until you configure a reachable OTLP endpoint.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=service.namespace=preflyt,deployment.environment.name=production
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_EXPORTER_OTLP_TIMEOUT=3000
OTEL_PROPAGATORS=tracecontext,baggage
# Optional full per-signal URLs (HTTP includes /v1/traces, /v1/metrics, /v1/logs).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# Optional collector profile: its external upstream must be configured separately.
COLLECTOR_UPSTREAM_ENDPOINT=
COLLECTOR_UPSTREAM_HEADERS={}

# Manual observe-only check publication; repository Checks: write required.

# Optional installation reporting is enabled by default (opt-out).
# A receiver URL is required before any report can be delivered.
# Set false before the first startup to prevent all installation reports.
PREFLYT_INSTALLATION_REPORTING_ENABLED=true
PREFLYT_INSTALLATION_REPORTING_URL=
# compose, kubernetes, linux, development, or unknown; no host/repository details.
PREFLYT_DEPLOYMENT_TYPE=unknown

# Country reporting is off until an administrator enables it. Set false to enforce off.
PREFLYT_INSTALLATION_COUNTRY_REPORTING_ENABLED=

# Workspace cleanup is off until an Owner/Admin enables it in Settings.
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_BATCH=250
