# Canonical Docker Compose configuration. Copy to root .env and protect it.
# Generate fresh hexadecimal database passwords. Do not reuse apps/api/.env.
POSTGRES_PASSWORD=
DATABASE_APP_PASSWORD=
PREFLYT_VERSION=development
PREFLYT_HTTP_PORT=8080
# Production: external HTTPS origin behind your host's TLS reverse proxy.
# Local-only: use http://localhost:8080 with compose.local.yaml.
WEB_ORIGIN=https://preflyt.example.com
# Configure both values to seed the recovery account (password: 24-128 chars).
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
# OIDC is optional in Super Admin-only mode. Otherwise configure all four.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
BOOTSTRAP_TOKEN_SHA256=
# GitHub onboarding is optional; configure all App settings when enabling it.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Single-quoted PEM text using literal \n escapes is supported by the API.
GITHUB_APP_PRIVATE_KEY=

# Bundled cache service; override only for a separately managed service.
REDIS_URL=redis://cache:6379/0
REDIS_CACHE_PREFIX=preflyt:production:cache

# Webhook ingestion is opt-in; the worker starts with the stack and waits for events.
GITHUB_EVENTS_ENABLED=false
GITHUB_WEBHOOK_SECRET=
# Compose has separate cache and persistent queue services; no host Redis is needed.
QUEUE_REDIS_URL=redis://queue:6379/0
QUEUE_PREFIX=preflyt:production:queue

# Local source builds use preflyt-local. Published releases use ghcr.io/lyrisoft.
PREFLYT_IMAGE_REGISTRY=preflyt-local
# Telemetry is disabled until you configure a reachable OTLP endpoint.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=service.namespace=preflyt,deployment.environment.name=production
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_EXPORTER_OTLP_TIMEOUT=3000
OTEL_PROPAGATORS=tracecontext,baggage
# Optional full per-signal URLs (HTTP includes /v1/traces, /v1/metrics, /v1/logs).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# Optional collector profile: its external upstream must be configured separately.
COLLECTOR_UPSTREAM_ENDPOINT=
COLLECTOR_UPSTREAM_HEADERS={}
