# Preflyt sample configuration - architecture draft.
# Application services and Docker Compose manifests are not implemented yet.
# Copy to .env after the deployment stack is built.

# OpenTelemetry
OTEL_SDK_DISABLED=false
OTEL_RESOURCE_ATTRIBUTES=service.namespace=preflyt,deployment.environment.name=production

# The service name is overridden for each container by the Compose manifest.
# OTEL_SERVICE_NAME=preflyt-api

# Common protocols: http/protobuf (OTLP HTTP/4318), grpc (OTLP gRPC/4317)
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Replace with your external OTLP-compatible APM endpoint.
# Use http://otel-collector:4318 ONLY if the collector Compose profile is enabled.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Optional OTLP headers; use deployment secrets when possible.
OTEL_EXPORTER_OTLP_HEADERS=

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_PROPAGATORS=tracecontext,baggage

# Optional per-signal endpoints. For OTLP/HTTP these are full signal URLs.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
