# Application connections and feature switches: Settings → Configuration.
# Legacy environment values are imported once on first API startup.
# Keep this key stable and back it up separately from the database.
CONFIGURATION_ENCRYPTION_KEY=
# Generate before first startup: a separate persistent 32-byte base64 key.
# API and worker must use the same value. Never reuse another encryption key.
AI_PROVIDER_ENCRYPTION_KEY=
# Canonical Docker Compose configuration. Copy to root .env and protect it.
# Generate fresh hexadecimal database passwords. Do not reuse apps/api/.env.
POSTGRES_PASSWORD=
DATABASE_APP_PASSWORD=
PREFLYT_VERSION=development
PREFLYT_HTTP_PORT=8080
# Production: external HTTPS origin behind your host's TLS reverse proxy.
# Local-only: use http://localhost:8080 with compose.local.yaml.
WEB_ORIGIN=https://preflyt.example.com
# Configure both values to seed the recovery account (password: 24-128 chars).
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
# Identity provider connections are configured in Settings → Configuration.
BOOTSTRAP_TOKEN_SHA256=

# Bundled cache service; override only for a separately managed service.
REDIS_URL=redis://cache:6379/0
REDIS_CACHE_PREFIX=preflyt:production:cache

# Webhook ingestion is opt-in; the worker starts with the stack and waits for events.
# Compose has separate cache and persistent queue services; no host Redis is needed.
QUEUE_REDIS_URL=redis://queue:6379/0
QUEUE_PREFIX=preflyt:production:queue

# Local source builds use preflyt-local. Published releases use ghcr.io/lyrisoft.
PREFLYT_IMAGE_REGISTRY=preflyt-local
# Telemetry is disabled until you configure a reachable OTLP endpoint.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=service.namespace=preflyt,deployment.environment.name=production
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_EXPORTER_OTLP_TIMEOUT=3000
OTEL_PROPAGATORS=tracecontext,baggage
# Optional full per-signal URLs (HTTP includes /v1/traces, /v1/metrics, /v1/logs).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# Optional collector profile: its external upstream must be configured separately.
COLLECTOR_UPSTREAM_ENDPOINT=
COLLECTOR_UPSTREAM_HEADERS={}

# Optional GitHub human login; disabled until the App callback and Members read access are configured.
# Base64 of 32 random bytes: openssl rand -base64 32. Keep in deployment secrets/backups.
GITHUB_USER_TOKEN_ENCRYPTION_KEY=

# Durable assessment inbox; requires database migration and the Redis worker.

# Users opt in to email after SMTP is provisioned in Settings.
# Development-only loopback SMTP test server; ignored in production.
SMTP_ALLOW_INSECURE_LOCAL=false

# Manual policy-aware check publication; Checks: write and Actions: read required.

# Production governance/evidence setup: docs/deployment/github-governance-production.md
# These settings require explicit container environment forwarding; see that guide.
# Ruleset activation uses the connected GitHub App by default.
# A separate governance App is optional in Settings; no local exception flag is needed.
# Read-only container paths and hashes for the offline attestation verifier.
CI_ATTESTATION_GH_PATH=
CI_ATTESTATION_GH_SHA256=
CI_ATTESTATION_ROOT_PATH=
CI_ATTESTATION_ROOT_SHA256=
CI_ATTESTATION_WORKFLOWS=
CI_EXECUTION_CONTRACTS=
# Host directory used by the optional reviewed evidence Compose override.
PREFLYT_ATTESTATION_DIR=

# Report proof: github-native (default) or organization-key for private repositories.
CI_REPORT_PROOF_MODE=github-native
# Public key allowlist JSON only; never include private signing keys.
CI_ORGANIZATION_SIGNER_KEYS=

# Optional retained GitHub ruleset evaluations (repository Administration: read).

# P3 read-only sandbox preflight. Does not enable repository execution.
# Enable only with a current independent runtime review and a deployed job controller.
NATIVE_RUNTIME_APPROVAL=
NATIVE_RUNTIME_REVIEW_KEYS=[]
NATIVE_CONTROLLER_API_KEY=

# Native check planning only. Reviewed image digests/config/license; never repository-supplied commands.
NATIVE_TOOL_REVIEWS=[]

# Organization AI configuration; no inference or repository source transmission in this release.
# Advisory instruction-only reviews; requires tested routes and model rates.
# AI_PROVIDER_ENCRYPTION_KEY is declared with the startup encryption settings above.
# Models and endpoints are created by organization admins in AI Intelligence.
