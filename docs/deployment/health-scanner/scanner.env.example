# Only the dedicated engine's client credentials belong on this host.
DOCKER_HOST=tcp://your-dedicated-scanner-engine:2376
DOCKER_TLS_VERIFY=1
DOCKER_CERT_PATH=/run/docker-tls
# Must resolve to the scanner; use TLS name health-scanner, localhost or IP 127.0.0.1.
HEALTH_SCANNER_ORIGIN=https://health-scanner:3011
