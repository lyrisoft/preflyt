FROM node@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
RUN mkdir -p /opt/preflyt && touch /opt/preflyt/empty-npmrc && test "$(yarn --version)" = "1.22.22" && npm install --global --ignore-scripts pnpm@10.26.2 && npm install --prefix /opt/preflyt/test-tools --ignore-scripts --no-audit --no-fund yaml@2.9.1 fast-xml-parser@5.11.2
COPY runner.mjs semgrep-locations.mjs source-verification.mjs adapters.json /opt/preflyt/
COPY coverage /opt/preflyt/coverage
# Separate image: the general native Node adapter retains its existing recipe.
RUN node -e "const fs=require('fs'),p='/opt/preflyt/adapters.json',a=JSON.parse(fs.readFileSync(p));a['tests.coverage'].args=['/opt/preflyt/coverage/repository-run.mjs'];fs.writeFileSync(p,JSON.stringify(a))"
USER 65532:65532
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/node", "/opt/preflyt/runner.mjs"]
