# Dedicated Docker controller. Never load the API or worker dotenv file.
NATIVE_RUNTIME_BACKEND=docker
NATIVE_CONTROLLER_HOST=0.0.0.0
NATIVE_CONTROLLER_PORT=3010
NATIVE_CONTROLLER_API_KEY=
NATIVE_CONTROLLER_SIGNING_KEY=
NATIVE_DOCKER_APPROVAL=
NATIVE_RUNTIME_REVIEW_KEYS=[]
NATIVE_TOOL_REVIEWS=[]
# Dedicated remote Docker engine with mutual TLS, not the application host engine.
DOCKER_HOST=tcp://your-dedicated-runner:2376
DOCKER_TLS_VERIFY=1
DOCKER_CERT_PATH=/run/docker-tls
