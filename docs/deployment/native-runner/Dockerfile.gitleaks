FROM zricethezav/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f AS tool
FROM node@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
COPY --from=tool /usr/bin/gitleaks /usr/local/bin/gitleaks
COPY runner.mjs source-verification.mjs adapters.json /opt/preflyt/
COPY config /opt/preflyt/config
USER 65532:65532
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/node", "/opt/preflyt/runner.mjs"]
