FROM node@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
WORKDIR /opt/preflyt/duplication
COPY duplication/package.json duplication/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY duplication/scan.mjs duplication/compact-store.mjs ./
COPY runner.mjs semgrep-locations.mjs source-verification.mjs source-initializer.mjs adapters.json /opt/preflyt/
USER 65532:65532
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/node", "/opt/preflyt/runner.mjs"]
