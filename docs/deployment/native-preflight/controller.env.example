# Dedicated controller environment; never load apps/api/.env here.
NATIVE_CONTROLLER_HOST=0.0.0.0
NATIVE_CONTROLLER_PORT=3010
NATIVE_CONTROLLER_API_KEY=
NATIVE_CONTROLLER_SIGNING_KEY=
NATIVE_RUNTIME_BACKEND=kubernetes
NATIVE_RUNTIME_APPROVAL=
NATIVE_RUNTIME_REVIEW_KEYS=[]
NATIVE_CLUSTER_SERVER=https://your-dedicated-api-server
NATIVE_CLUSTER_CA_FILE=/run/native/cluster-ca.crt
NATIVE_CLUSTER_TOKEN_FILE=/run/native/observer-token
