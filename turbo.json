{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build"
      ],
      "passThroughEnv": [
        "DATABASE_URL"
      ]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": [
        "^typecheck"
      ],
      "passThroughEnv": [
        "DATABASE_URL"
      ]
    },
    "test": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "format:check": {
      "outputs": []
    },
    "@preflyt/web#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/deploy/nginx.conf",
        "$TURBO_ROOT$/deploy/nginx.website.conf",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".prerender/**"
      ],
      "env": [
        "VITE_WEBSITE_MODE",
        "VITE_API_BASE_URL",
        "PUBLIC_SITE_URL",
        "PUBLIC_SITE_INDEXABLE"
      ]
    },
    "@preflyt/docs#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/deploy/**",
        "$TURBO_ROOT$/docker-compose.yaml",
        "$TURBO_ROOT$/.env.example"
      ],
      "outputs": [
        "build/**",
        "static/downloads/**",
        "docs/_generated/**",
        "docs/self-hosting/compose-file.md"
      ],
      "env": [
        "DOCS_URL",
        "DOCS_BASE_URL",
        "PREFLYT_DOCS_REGISTRY"
      ]
    }
  }
}
