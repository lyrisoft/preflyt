diff --git a/lib/validate-depth.js b/lib/validate-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..69fc2ba96a1a0468bde5c856919a78de33dc1999
--- /dev/null
+++ b/lib/validate-depth.js
@@ -0,0 +1,18 @@
+'use strict';
+
+// Preflyt security patch for GHSA-vfj7-8cjw-p6xm (2026-10-16).
+// Check child depth iteratively before entering any recursive AST walker.
+const MAX_DEPTH = 128;
+const validateDepth = ast => {
+  const stack = [[ast, 0]];
+  while (stack.length) {
+    const [node, depth] = stack.pop();
+    if (depth > MAX_DEPTH) {
+      throw new SyntaxError('Brace pattern exceeds maximum nesting depth (128)');
+    }
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) stack.push([child, depth + 1]);
+    }
+  }
+};
+module.exports = { MAX_DEPTH, validateDepth };
